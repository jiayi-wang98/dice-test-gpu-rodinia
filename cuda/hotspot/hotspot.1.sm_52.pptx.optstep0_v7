// DICECompiler PPTX for: hotspot (RF-unified v7, real-addr SRF)
// BLOCK_SIZE=16, 2D 16x16 = 256-thread CTA, tid_in_cta = ty*16 + tx.
//
// Publication reg = %r10 (carries center temp each iter, f32).
// Power reg      = %r11 (loop-invariant per-thread, f32).
// SRF address = neighbor_tid * 32 + 10  (word units: bits[4:0]=10, bits[14:5]=tid).
//
// Neighbor TIDs (linear): for thread (ty,tx), tid = ty*16+tx,
//   N_tid = max(ty-1, validYmin)*16 + tx
//   S_tid = min(ty+1, validYmax)*16 + tx
//   W_tid = ty*16 + max(tx-1, validXmin)
//   E_tid = ty*16 + min(tx+1, validXmax)
// Bank conflict: N-S differ by 32 in tid → same (tid+10)%32 bank
//   → DBB 7 (compute) has DISPATCH_II = 2.
//
// Loop body split to avoid intra-DBB publication race:
//   DBB 7 : BARRIER, 4 ld.srf, full compute → capture in %r15 (f32)
//   DBB 8 : publish %r10 = %r15 (predicated), counter++, branch back to DBB 6
// cgra_fabric_done forces all threads finish DBB 7 before any thread
// dispatches DBB 8, so DBB 7 always reads OLD %r10 globally.
//
.version 7.7
.target sm_52
.address_size 64
.visible .entry _Z14calculate_tempiPfS_S_iiiiffffff(
.param .u32 _Z14calculate_tempiPfS_S_iiiiffffff_param_0,
.param .u64 _Z14calculate_tempiPfS_S_iiiiffffff_param_1,
.param .u64 _Z14calculate_tempiPfS_S_iiiiffffff_param_2,
.param .u64 _Z14calculate_tempiPfS_S_iiiiffffff_param_3,
.param .u32 _Z14calculate_tempiPfS_S_iiiiffffff_param_4,
.param .u32 _Z14calculate_tempiPfS_S_iiiiffffff_param_5,
.param .u32 _Z14calculate_tempiPfS_S_iiiiffffff_param_6,
.param .u32 _Z14calculate_tempiPfS_S_iiiiffffff_param_7,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_8,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_9,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_10,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_11,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_12,
.param .f32 _Z14calculate_tempiPfS_S_iiiiffffff_param_13
)
{
.reg .b32 %c<32>;
.reg .b32 %r<32>;
.reg .pred %p<32>;
.reg .b32 %w<32>;

$DICE_BB0_0:
ld.param.u32 %c0, [_Z14calculate_tempiPfS_S_iiiiffffff_param_0];
ld.param.u64 %c1, [_Z14calculate_tempiPfS_S_iiiiffffff_param_1];
ld.param.u64 %c2, [_Z14calculate_tempiPfS_S_iiiiffffff_param_2];
ld.param.u64 %c3, [_Z14calculate_tempiPfS_S_iiiiffffff_param_3];
ld.param.u32 %c4, [_Z14calculate_tempiPfS_S_iiiiffffff_param_4];
ld.param.u32 %c5, [_Z14calculate_tempiPfS_S_iiiiffffff_param_5];
ld.param.u32 %c6, [_Z14calculate_tempiPfS_S_iiiiffffff_param_6];
ld.param.u32 %c7, [_Z14calculate_tempiPfS_S_iiiiffffff_param_7];
ld.param.f32 %c8, [_Z14calculate_tempiPfS_S_iiiiffffff_param_8];
ld.param.f32 %c9, [_Z14calculate_tempiPfS_S_iiiiffffff_param_9];
ld.param.f32 %c10, [_Z14calculate_tempiPfS_S_iiiiffffff_param_10];
ld.param.f32 %c11, [_Z14calculate_tempiPfS_S_iiiiffffff_param_11];
ld.param.f32 %c12, [_Z14calculate_tempiPfS_S_iiiiffffff_param_12];

$DICE_BB0_1:
// blkY/X, yidx/xidx, OOB, ld.global temp (%r10), power (%r11).
shl.b32 %w0, %c0, 1;
mov.u32 %w1, 16;
sub.s32 %r0, %w1, %w0;             // small_block = 16 - 2*iter
mov.u32 %w2, %ctaid.y;
mul.lo.s32 %w3, %r0, %w2;
sub.s32 %r1, %w3, %c7;             // blkY
mov.u32 %w4, %ctaid.x;
mul.lo.s32 %w5, %r0, %w4;
sub.s32 %r2, %w5, %c6;             // blkX
mov.u32 %r3, %tid.y;               // ty
mov.u32 %r4, %tid.x;               // tx
add.s32 %r5, %r1, %r3;             // yidx
add.s32 %r6, %r2, %r4;             // xidx
setp.ge.s32 %p0, %r5, 0;
setp.lt.s32 %p1, %r5, %c5;
and.pred %p2, %p0, %p1;
setp.ge.s32 %p3, %r6, 0;
setp.lt.s32 %p4, %r6, %c4;
and.pred %p5, %p3, %p4;
and.pred %p6, %p2, %p5;            // in-range OOB predicate
mad.lo.s32 %r7, %r5, %c4, %r6;     // global index
cvta.to.global.u64 %w6, %c2;
mul.wide.s32 %w7, %r7, 4;
add.s64 %r8, %w6, %w7;             // &temp_src[index]
cvta.to.global.u64 %w8, %c1;
add.s64 %r9, %w8, %w7;             // &power[index]
@%p6 ld.global.f32 %r10, [%r8];
@%p6 ld.global.f32 %r11, [%r9];

$DICE_BB0_2:
// validYmin = (blkY<0)?-blkY:0;  validYmax computed similarly.
neg.s32 %w0, %r1;
shr.s32 %w1, %r1, 31;
and.b32 %r12, %w0, %w1;            // validYmin = max(-blkY, 0)
add.s32 %w2, %r1, 15;
setp.lt.s32 %p7, %w2, %c5;
mov.u32 %w3, -15;
sub.s32 %w4, %w3, %r1;
add.s32 %w5, %c5, %w4;
add.s32 %w6, %w5, 14;
selp.b32 %r13, 15, %w6, %p7;       // validYmax

$DICE_BB0_3:
// validXmin, validXmax, isValid (intersected with %p6 from DBB 1).
neg.s32 %w0, %r2;
shr.s32 %w1, %r2, 31;
and.b32 %r14, %w0, %w1;            // validXmin
add.s32 %w2, %r2, 15;
setp.lt.s32 %p8, %w2, %c4;
mov.u32 %w3, -15;
sub.s32 %w4, %w3, %r2;
add.s32 %w5, %c4, %w4;
add.s32 %w6, %w5, 14;
selp.b32 %r15, 15, %w6, %p8;       // validXmax
setp.ge.s32 %p9, %r3, %r12;
setp.le.s32 %p10, %r3, %r13;
setp.ge.s32 %p11, %r4, %r14;
setp.le.s32 %p12, %r4, %r15;
and.pred %p13, %p9, %p10;
and.pred %p14, %p11, %p12;
and.pred %p6, %p13, %p14;          // isValid (replace, was OOB-only)
setp.lt.s32 %p15, %c0, 1;
@%p15 bra $DICE_BB0_19;

$DICE_BB0_4:
// Compute reciprocals (Rx_1, Ry_1, Rz_1) and step_div_Cap, all f64.
rcp.rn.f32 %w0, %c10;              // Rx_1 f32
cvt.f64.f32 %r16, %w0;             // Rx_1 f64
rcp.rn.f32 %w1, %c9;               // Ry_1 f32
cvt.f64.f32 %r17, %w1;             // Ry_1 f64
rcp.rn.f32 %w2, %c11;              // Rz_1 f32
cvt.f64.f32 %r18, %w2;             // Rz_1 f64
div.rn.f32 %w3, %c12, %c8;         // step/Cap f32
cvt.f64.f32 %r19, %w3;             // step_div_Cap f64

$DICE_BB0_5:
// Clamp N/S/W/E ty/tx; build linear neighbor TIDs and SRF addrs (word units).
//   addr = neighbor_tid * 32 + 10
// N = max(ty-1, validYmin); S = min(ty+1, validYmax)
// W = max(tx-1, validXmin); E = min(tx+1, validXmax)
add.s32 %w0, %r3, -1;
max.s32 %w1, %w0, %r12;            // N_ty
add.s32 %w2, %r3, 1;
min.s32 %w3, %w2, %r13;            // S_ty
add.s32 %w4, %r4, -1;
max.s32 %w5, %w4, %r14;            // W_tx
add.s32 %w6, %r4, 1;
min.s32 %w7, %w6, %r15;            // E_tx
shl.b32 %w8, %w1, 4;
add.s32 %w9, %w8, %r4;             // N_tid = N_ty*16 + tx
shl.b32 %w10, %w9, 5;
add.s32 %r20, %w10, 10;            // N_addr
shl.b32 %w11, %w3, 4;
add.s32 %w12, %w11, %r4;           // S_tid
shl.b32 %w13, %w12, 5;
add.s32 %r21, %w13, 10;            // S_addr
shl.b32 %w14, %r3, 4;
add.s32 %w15, %w14, %w5;           // W_tid = ty*16 + W_tx
shl.b32 %w16, %w15, 5;
add.s32 %r22, %w16, 10;            // W_addr
add.s32 %w17, %w14, %w7;           // E_tid
shl.b32 %w18, %w17, 5;
add.s32 %r23, %w18, 10;            // E_addr
mov.u32 %r24, 0;                   // counter i

$DICE_BB0_6:
// Per-iter narrowing predicate %p20 = isValid AND tx,ty in [i+1, 14-i].
mov.u32 %w0, 14;
sub.s32 %w1, %w0, %r24;            // 14 - i
setp.gt.s32 %p16, %r3, %r24;       // ty > i
setp.le.s32 %p17, %r3, %w1;        // ty <= 14-i
setp.gt.s32 %p18, %r4, %r24;       // tx > i
setp.le.s32 %p19, %r4, %w1;        // tx <= 14-i
and.pred %p20, %p16, %p17;
and.pred %p21, %p18, %p19;
and.pred %p22, %p20, %p21;
and.pred %p20, %p22, %p6;          // also AND isValid

$DICE_BB0_7:
// BARRIER + 4 ld.srf (N,S,W,E) + f64 compute → %w_new (f32), capture in %r25.
// N and S share the same SRF bank (tids differ by 32 → same (tid+10)%32).
// DISPATCH_II = 2 declared in meta.
@%p20 ld.srf.f32 %w0, [%r20];      // N
@%p20 ld.srf.f32 %w1, [%r21];      // S
@%p20 ld.srf.f32 %w2, [%r22];      // W
@%p20 ld.srf.f32 %w3, [%r23];      // E
add.f32 %w4, %w0, %w1;             // N + S
add.f32 %w5, %w2, %w3;             // W + E
cvt.f64.f32 %w6, %w4;
cvt.f64.f32 %w7, %w5;
cvt.f64.f32 %w8, %r10;             // c (f64)
cvt.f64.f32 %w9, %r11;             // power (f64)
add.f64 %w10, %w8, %w8;            // 2c
sub.f64 %w11, %w6, %w10;           // (N+S) - 2c
sub.f64 %w12, %w7, %w10;           // (W+E) - 2c
mov.f64 %w13, 0d4054000000000000;  // 80.0 (amb_temp)
sub.f64 %w14, %w13, %w8;           // amb - c
fma.rn.f64 %w15, %w11, %r17, %w9;  // Ry_1*nsd + power
fma.rn.f64 %w16, %w12, %r16, %w15; // + Rx_1*wed
fma.rn.f64 %w17, %w14, %r18, %w16; // + Rz_1*ambd
fma.rn.f64 %w18, %w17, %r19, %w8;  // * sdc + c
cvt.rn.f32.f64 %w19, %w18;
@%p20 mov.b32 %r25, %w19;

$DICE_BB0_8:
// Publish %r10 = %r25 (predicated on computed AND not-last-iter); counter++; branch.
add.s32 %w0, %r24, 1;
setp.lt.s32 %p23, %w0, %c0;        // i+1 < iter
and.pred %p24, %p23, %p20;
@%p24 mov.b32 %r10, %r25;
add.s32 %r24, %r24, 1;
setp.lt.s32 %p25, %r24, %c0;       // i < iter
@%p25 bra $DICE_BB0_6;

$DICE_BB0_16:
// Store temp_dst[index] = %r25 if isValid AND tx,ty in [iter, 15-iter]
// (the threads that "computed" on the LAST iter).
add.s32 %w0, %c0, -1;
setp.gt.s32 %p26, %r3, %w0;        // ty >= iter
mov.u32 %w1, 15;
sub.s32 %w2, %w1, %c0;             // 15 - iter
setp.le.s32 %p27, %r3, %w2;
setp.gt.s32 %p28, %r4, %w0;        // tx >= iter
setp.le.s32 %p29, %r4, %w2;
and.pred %p30, %p26, %p27;
and.pred %p31, %p28, %p29;
and.pred %p26, %p30, %p31;
and.pred %p26, %p26, %p6;
cvta.to.global.u64 %w3, %c3;
mul.wide.s32 %w4, %r7, 4;
add.s64 %r26, %w3, %w4;
@%p26 st.global.f32 [%r26], %r25;

$DICE_BB0_19:
ret;

}
