OUT_REGS = (%r12, %r13);

DBB_ID = 3,
BITSTREAM_ADDR = $DICE_BB0_3,
BITSTREAM_LENGTH = 17,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 6,
IN_REGS = (%c0, %c4, %p6, %r2, %r3, %r4, %r12, %r13),
OUT_REGS = (%p6, %p15, %r14, %r15),
BRANCH = 1,
BRANCH_PRED = (%p15),
BRANCH_TARGET = 19,
BRANCH_RECVPC = 19;

DBB_ID = 4,
BITSTREAM_ADDR = $DICE_BB0_4,
BITSTREAM_LENGTH = 8,
UNROLLING_FACTOR = 2,
UNROLLING_STRATEGY = 0,
LAT = 6,
IN_REGS = (%c8, %c9, %c10, %c11, %c12),
OUT_REGS = (%r16, %r17, %r18, %r19);

DBB_ID = 5,
BITSTREAM_ADDR = $DICE_BB0_5,
BITSTREAM_LENGTH = 21,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 6,
IN_REGS = (%r3, %r4, %r12, %r13, %r14, %r15),
OUT_REGS = (%r20, %r21, %r22, %r23, %r24);

DBB_ID = 6,
BITSTREAM_ADDR = $DICE_BB0_6,
BITSTREAM_LENGTH = 9,
UNROLLING_FACTOR = 2,
UNROLLING_STRATEGY = 0,
LAT = 4,
IN_REGS = (%p6, %r3, %r4, %r24),
OUT_REGS = (%p20);

DBB_ID = 7,
BITSTREAM_ADDR = $DICE_BB0_7,
BITSTREAM_LENGTH = 21,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 12,
// N/S share bank: (N_tid - S_tid) = 32 -> same (tid+10)%32 bank.
// 4 ld.srf reads with one conflict -> DISPATCH_II = 2.
IN_REGS = (%p20, %r10, %r11, %r16, %r17, %r18, %r19, %r20, %r21, %r22, %r23),
OUT_REGS = (%r25),
