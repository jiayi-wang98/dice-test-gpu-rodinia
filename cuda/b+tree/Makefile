# ========================================================================================================================================================================================================200
#	EXECUTABLES (LINK OBJECTS TOGETHER INTO BINARY)
# ========================================================================================================================================================================================================200

b+tree.out:	ptx \
		./main.o \
		./kernel/kernel_gpu_cuda_wrapper.o \
		./kernel/kernel_gpu_cuda_wrapper_2.o \
		./util/timer/timer.o \
		./util/num/num.o \
		./util/cuda/cuda.o
	$(C_C)	./main.o \
			./kernel/kernel_gpu_cuda_wrapper.o \
			./kernel/kernel_gpu_cuda_wrapper_2.o \
			./util/timer/timer.o \
			./util/num/num.o \
			./util/cuda/cuda.o \
			-lm \
			-L$(CUDA_LIB_DIR) \
				$(ASAN_LDFLAGS) \
				$(CUDA_LIB)\
	                       -o b+tree.out


# ======================================================================================================================================================150
#	PTX (default: unrolled; set PTX_UNROLL=0 for no-unroll + O0)
# ======================================================================================================================================================150

.PHONY: ptx
ifeq ($(PTX_UNROLL),1)
ptx:
	$(CUD_C) $(KERNEL_DIM) $(PTX_FLAG_BASE) $(PTX_FLAG_UNROLL) ./kernel/kernel_gpu_cuda_wrapper.cu -o ./b+tree.1.sm_52.ptx
	$(CUD_C) $(KERNEL_DIM) $(PTX_FLAG_BASE) $(PTX_FLAG_UNROLL) ./kernel/kernel_gpu_cuda_wrapper_2.cu -o ./b+tree.2.sm_52.ptx
	@printf '$(PTX_STUB3)' > ./b+tree.3.sm_52.ptx
else
ptx:
	@mkdir -p $(PTX_GEN_DIR)
	@printf '#include "%s/common.h"\nextern "C" {\n' "$(CURDIR)" > $(PTX_GEN_FINDK)
	@sed '/for(i = 0; i < height; i++){/i #pragma unroll 1' ./kernel/kernel_gpu_cuda.cu >> $(PTX_GEN_FINDK)
	@printf '\n}\n' >> $(PTX_GEN_FINDK)
	@printf '#include "%s/common.h"\nextern "C" {\n' "$(CURDIR)" > $(PTX_GEN_FINDRANGE)
	@sed '/for(i = 0; i < height; i++){/i #pragma unroll 1' ./kernel/kernel_gpu_cuda_2.cu >> $(PTX_GEN_FINDRANGE)
	@printf '\n}\n' >> $(PTX_GEN_FINDRANGE)
	$(CUD_C) $(KERNEL_DIM) $(PTX_FLAG_BASE) $(PTX_FLAG_NOUNROLL) $(PTX_GEN_FINDK) -o ./b+tree.1.sm_52.ptx
	$(CUD_C) $(KERNEL_DIM) $(PTX_FLAG_BASE) $(PTX_FLAG_NOUNROLL) $(PTX_GEN_FINDRANGE) -o ./b+tree.2.sm_52.ptx
	@printf '$(PTX_STUB3)' > ./b+tree.3.sm_52.ptx
endif


# ========================================================================================================================================================================================================200
#	OBJECTS (COMPILE SOURCE FILES INTO OBJECTS)
# ========================================================================================================================================================================================================200

# ======================================================================================================================================================150
#	MAIN FUNCTION
# ======================================================================================================================================================150

main.o:	./common.h \
		./main.h \
		./main.c
	$(C_C)	$(KERNEL_DIM) ./main.c \
			-c \
			-o ./main.o \
			-O3 \
			$(ASAN_CFLAGS)
# ======================================================================================================================================================150
#	KERNELS
# ======================================================================================================================================================150

./kernel/kernel_gpu_cuda_wrapper.o:	./common.h \
									./kernel/kernel_gpu_cuda_wrapper.h \
									./kernel/kernel_gpu_cuda_wrapper.cu
	$(CUD_C) $(KERNEL_DIM) ./kernel/kernel_gpu_cuda_wrapper.cu \
				-c \
				-o ./kernel/kernel_gpu_cuda_wrapper.o \
				-O3 \
				$(CUDA_FLAG)

./kernel/kernel_gpu_cuda_wrapper_2.o:	./common.h \
										./kernel/kernel_gpu_cuda_wrapper_2.h \
										./kernel/kernel_gpu_cuda_wrapper_2.cu
	$(CUD_C) $(KERNEL_DIM) ./kernel/kernel_gpu_cuda_wrapper_2.cu \
				-c \
				-o ./kernel/kernel_gpu_cuda_wrapper_2.o \
				-O3 \
				$(CUDA_FLAG)

# ======================================================================================================================================================150
#	UTILITIES
# ======================================================================================================================================================150

./util/timer/timer.o:	./common.h \
						./util/timer/timer.h \
						./util/timer/timer.c
	$(C_C)	./util/timer/timer.c \
			-c \
			-o ./util/timer/timer.o \
			-O3 \
			$(ASAN_CFLAGS)

./util/num/num.o:	./common.h \
					./util/num/num.h \
					./util/num/num.c
	$(C_C)	./util/num/num.c \
			-c \
			-o ./util/num/num.o \
			-O3 \
			$(ASAN_CFLAGS)

./util/cuda/cuda.o:	./common.h \
					./util/cuda/cuda.h \
					./util/cuda/cuda.cu
	$(CUD_C)	./util/cuda/cuda.cu \
				-c \
				-o ./util/cuda/cuda.o \
				-O3 \
				$(CUDA_FLAG)

