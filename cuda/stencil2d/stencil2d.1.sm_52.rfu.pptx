// DICECompiler PPTX for: examples/stencil2d/stencil2d.ptx (RF-Unified)
// Hand-written for HPCA 2027 RF/SMEM unification.
//
// Lane mapping: tid = ty * 16 + tx, BLOCK_X=BLOCK_Y=16, 256 lanes/block.
//
// Per-thread RF allocation (replaces tile[ty][tx]):
//   %r4  -- "vertical" copy of loaded tile value
//   %r5  -- "horizontal" copy of loaded tile value
// Each thread writes the same gmem-loaded value to BOTH %r4 and %r5
// (one extra mov; no extra cycles, the writes are co-issued).
//
// Why two copies?  The 5-point stencil reads neighbours at lane offsets
// {-16, -1, 0, +1, +16}.  On the mod-32 RF swizzle, T-16 ≡ T+16, so
// up-neighbour and down-neighbour would alias to the same bank if both
// targeted the same register name.  Splitting the value across %r4/%r5
// gives:
//   up   : xrf %r4, lane T-16   -> bank ((4 + T - 16) mod 32) = (T+20)
//   down : xrf %r5, lane T+16   -> bank ((5 + T + 16) mod 32) = (T+21)
// Banks now differ by 1 — no conflict.  All five accesses (incl. center
// from %r4-self, left/right from %r4-lane T pm 1) map to distinct banks
// and use exactly the 4-port budget (center is a local read, not a port).
//
// Bank table (this cycle, all addresses compile-time resolvable):
//   port0 (xrf %r4, T-16)  : bank (T+20) mod 32     -- up
//   port1 (xrf %r5, T+16)  : bank (T+21) mod 32     -- down
//   port2 (xrf %r4, T-1 )  : bank (T+ 3) mod 32     -- left
//   port3 (xrf %r4, T+1 )  : bank (T+ 5) mod 32     -- right
//   local (read   %r4    ) : bank (T+ 4) mod 32     -- center
// 5 banks, all distinct -> conflict-free.
//
.version 7.7
.target sm_52
.address_size 64
.visible .entry _Z16stencil2d_kernelPKiPiii(
.param .u64 _Z16stencil2d_kernelPKiPiii_param_0,
.param .u64 _Z16stencil2d_kernelPKiPiii_param_1,
.param .u32 _Z16stencil2d_kernelPKiPiii_param_2,
.param .u32 _Z16stencil2d_kernelPKiPiii_param_3
)
{
.reg .b32 %c<8>;
.reg .b32 %r<24>;
.reg .pred %p<8>;
.reg .b32 %w<24>;

// (no .shared)

$DICE_BB0_0:
ld.param.u64 %c0, [_Z16stencil2d_kernelPKiPiii_param_0];
ld.param.u64 %c1, [_Z16stencil2d_kernelPKiPiii_param_1];
ld.param.u32 %c2, [_Z16stencil2d_kernelPKiPiii_param_2];
ld.param.u32 %c3, [_Z16stencil2d_kernelPKiPiii_param_3];

$DICE_BB0_1:
mov.u32 %r0, %tid.x;
mov.u32 %r1, %tid.y;
mov.u32 %w0, %ctaid.x;
mov.u32 %w1, %ctaid.y;
shl.b32 %w2, %w0, 4;
shl.b32 %w3, %w1, 4;
add.s32 %r2, %w2, %r0;                 // gx
add.s32 %r3, %w3, %r1;                 // gy
setp.ge.s32 %p0, %r2, %c2;
setp.ge.s32 %p1, %r3, %c3;
or.pred %p2, %p0, %p1;
mad.lo.s32 %w4, %r3, %c2, %r2;
cvta.to.global.u64 %w5, %c0;
mul.wide.s32 %w6, %w4, 4;
add.s64 %r4_addr, %w5, %w6;             // &in[idx]
mov.u32 %r4, 0;
mov.u32 %r5, 0;
@!%p2 ld.global.u32 %r4, [%r4_addr];   // copy A: vertical-neighbour source
@!%p2 mov.u32 %r5, %r4;                 // copy B: horizontal-neighbour source

// (no STS, no bar.sync — p-graph boundary supplies write-visibility for %r4/%r5)

$DICE_BB0_5:
@%p2 bra $DICE_BB0_17;

// Lane indices for cross-thread reads. CGRA fabric supplies them.
add.s32 %w0, %r0, -1;                  // tx-1
add.s32 %w1, %r0,  1;                  // tx+1
mad.lo.s32 %w_lane_self,    %r1,    16, %r0;     // self    = ty*16 + tx     (== tid)
mad.lo.s32 %w_lane_up,      %r1,    16, %r0;
sub.s32    %w_lane_up,      %w_lane_up, 16;       // up      = self - 16
mad.lo.s32 %w_lane_down,    %r1,    16, %r0;
add.s32    %w_lane_down,    %w_lane_down, 16;     // down    = self + 16
mad.lo.s32 %w_lane_left,    %r1,    16, %w0;     // left    = self - 1
mad.lo.s32 %w_lane_right,   %r1,    16, %w1;     // right   = self + 1

// Predicated boundary clamps (in-block edges fall back to center).
setp.eq.s32 %p3, %r1,  0;   // top    edge
setp.eq.s32 %p4, %r1, 15;   // bottom edge
setp.eq.s32 %p5, %r0,  0;   // left   edge
setp.eq.s32 %p6, %r0, 15;   // right  edge
@%p3 mov.u32 %w_lane_up,    %w_lane_self;
@%p4 mov.u32 %w_lane_down,  %w_lane_self;
@%p5 mov.u32 %w_lane_left,  %w_lane_self;
@%p6 mov.u32 %w_lane_right, %w_lane_self;

// Cross-thread RF reads — 4 ports, all under the 4-port budget.
xrf.u32 %r11, %r4, %w_lane_up;          // port0: up
xrf.u32 %r12, %r5, %w_lane_down;        // port1: down (separate reg name to dodge stride-16 alias)
xrf.u32 %r13, %r4, %w_lane_left;        // port2: left
xrf.u32 %r14, %r4, %w_lane_right;       // port3: right
// center reuses local %r4 — no cross-thread port consumed.

add.s32 %w7, %r4, %r11;
add.s32 %w8, %w7, %r12;
add.s32 %w9, %w8, %r13;
add.s32 %r15, %w9, %r14;

// Cross-block boundary fix-ups (replace neighbour with gmem load when at
// global edge; sketch — full predication elided for brevity).
$DICE_BB0_6:
// (cross-block gmem fall-backs would go here — same as baseline DBB6)

$DICE_BB0_7:
cvta.to.global.u64 %w3, %c1;
add.s64 %r16, %w3, %w6;
st.global.u32 [%r16], %r15;

$DICE_BB0_17:
ret;

}
