inline double rsqrt(const double a)
{
  return 1.0 / sqrt(a);
}

inline double rcbrt(const double a)
{
  double s, t;

  if (__isnan(a)) {
    return a + a;
  }
  if (a == 0.0 || __isinf(a)) {
    return 1.0 / a;
  }
