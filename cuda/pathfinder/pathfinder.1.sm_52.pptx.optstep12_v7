// DICECompiler PPTX for: pathfinder (RF-unified v7, real-addr SRF)
// 256-thread CTA.  Publication reg = %r7 (carries "prev" each iter).
// SRF address = neighbor_tid * 32 + 7.
//
// CRITICAL ORDERING: ld.srf for neighbor %r7 and the write to local %r7
// cannot live in the same DBB -- the simulator runs functional updates
// per dispatched thread, so an earlier-dispatched thread's %r7 write
// would be visible to a later-dispatched thread's ld.srf in the same DBB.
// We use two loop-body DBBs separated by inter-DBB ordering:
//   DBB 6 : ld.srf old %r7, compute new value, capture into %r15
//   DBB 8 : publish %r7 = %r15 (predicated), counter++, branch back
// cgra_fabric_done forces all threads to finish DBB 6 before any thread
// dispatches into DBB 8 -- so DBB 6 always sees OLD %r7 globally.
//
// W = max(tx-1, validXmin)  ->  W_addr = W*32 + 7
// E = min(tx+1, validXmax)  ->  E_addr = E*32 + 7
// W and E are computed ONCE before the loop.
//
.version 7.7
.target sm_52
.address_size 64
.visible .entry _Z14dynproc_kerneliPiS_S_iiii(
.param .u32 _Z14dynproc_kerneliPiS_S_iiii_param_0,
.param .u64 _Z14dynproc_kerneliPiS_S_iiii_param_1,
.param .u64 _Z14dynproc_kerneliPiS_S_iiii_param_2,
.param .u64 _Z14dynproc_kerneliPiS_S_iiii_param_3,
.param .u32 _Z14dynproc_kerneliPiS_S_iiii_param_4,
.param .u32 _Z14dynproc_kerneliPiS_S_iiii_param_5,
.param .u32 _Z14dynproc_kerneliPiS_S_iiii_param_6,
.param .u32 _Z14dynproc_kerneliPiS_S_iiii_param_7
)
{
.reg .b32 %c<8>;
.reg .b32 %r<32>;
.reg .pred %p<32>;
.reg .b32 %w<32>;

$DICE_BB0_0:
ld.param.u32 %c0, [_Z14dynproc_kerneliPiS_S_iiii_param_0];
ld.param.u64 %c1, [_Z14dynproc_kerneliPiS_S_iiii_param_1];
ld.param.u64 %c2, [_Z14dynproc_kerneliPiS_S_iiii_param_2];
ld.param.u64 %c3, [_Z14dynproc_kerneliPiS_S_iiii_param_3];
ld.param.u32 %c4, [_Z14dynproc_kerneliPiS_S_iiii_param_4];
ld.param.u32 %c5, [_Z14dynproc_kerneliPiS_S_iiii_param_6];
ld.param.u32 %c6, [_Z14dynproc_kerneliPiS_S_iiii_param_7];

$DICE_BB0_1:
// xidx = blkX + tx; OOB check; publish %r7 = gpuSrc[xidx]
shl.b32 %w0, %c0, 1;
mov.u32 %w1, 256;
sub.s32 %w2, %w1, %w0;
mov.u32 %w3, %ctaid.x;
mul.lo.s32 %r0, %w2, %w3;
sub.s32 %r1, %r0, %c6;
mov.u32 %r2, %tid.x;
add.s32 %r3, %r1, %r2;
setp.lt.s32 %p0, %r3, 0;
setp.ge.s32 %p1, %r3, %c4;
or.pred %p2, %p0, %p1;
cvta.to.global.u64 %w0, %c2;
mul.wide.s32 %w1, %r3, 4;
add.s64 %r6, %w0, %w1;
@!%p2 ld.global.u32 %r7, [%r6];

$DICE_BB0_2:
// validXmin / validXmax + early-exit on iteration==0.
neg.s32 %w0, %r1;
shr.s32 %w1, %r1, 31;
and.b32 %r24, %w1, %w0;
add.s32 %w3, %r1, 255;
setp.lt.s32 %p31, %w3, %c4;
mov.u32 %w4, -255;
sub.s32 %w5, %w4, %r1;
add.s32 %w6, %c4, %w5;
add.s32 %w7, %w6, 254;
selp.b32 %r25, 255, %w7, %p31;
setp.lt.s32 %p3, %c0, 1;
@%p3 bra $DICE_BB0_7;

$DICE_BB0_3:
// One-time setup: W,E addr, isValid, init counter %r4, init %r15.
add.s32 %w0, %r2, -1;
max.s32 %w1, %w0, %r24;
shl.b32 %w2, %w1, 5;
add.s32 %r8, %w2, 7;
add.s32 %w3, %r2, 1;
min.s32 %w4, %w3, %r25;
shl.b32 %w5, %w4, 5;
add.s32 %r9, %w5, 7;
setp.ge.s32 %p4, %r2, %r24;
setp.le.s32 %p5, %r2, %r25;
and.pred %p6, %p4, %p5;
mov.u32 %r4, 0;
mov.u32 %r15, 0;
// optstep8 (#4): precompute gpuWall base ptr (%r10) and stride (%r11)
// so the loop body just needs an add.s64 to advance, not a full
// mad/cvta/mul.wide/add chain per iter.
mad.lo.s32 %w0, %c5, %c4, %r3;
cvta.to.global.u64 %w1, %c1;
mul.wide.s32 %w2, %w0, 4;
add.s64 %r10, %w1, %w2;
mul.wide.s32 %r11, %c4, 4;
// optstep12 (#4): hoist tx-bound prep for DBB 4 — saves 1 PE per iter.
add.s32 %r13, %r2, -1;
mov.u32 %w3, 255;
sub.s32 %r14, %w3, %r2;

$DICE_BB0_4:
// Per-iter narrowing predicate: %p10 = isValid AND tx in [%r4+1, 254-%r4].
// optstep12: tx-1 in %r13, 255-tx in %r14 precomputed in DBB 3.
setp.ge.s32 %p8, %r13, %r4;
setp.gt.s32 %p7, %r14, %r4;
and.pred %p9, %p7, %p8;
and.pred %p10, %p6, %p9;

$DICE_BB0_5:
// optstep8: now just the load (addr precomputed in DBB 3, incremented in DBB 8).
@%p10 ld.global.u32 %r20, [%r10];

$DICE_BB0_6:
// BARRIER + ld.srf (read OLD neighbor %r7) + compute + capture into %r15.
// No write to %r7 here -- defer to DBB 8 to avoid intra-DBB race.
@%p10 ld.srf.u32 %w2, [%r8];
@%p10 ld.srf.u32 %w3, [%r9];
min.s32 %w4, %w2, %r7;
min.s32 %w5, %w4, %w3;
add.s32 %w6, %w5, %r20;
@%p10 mov.b32 %r15, %w6;

$DICE_BB0_8:
// Publish %r7 = %r15 if (i+1 < iter) AND computed; counter++; branch.
// Safe: no ld.srf here, and DBB 6 already finished for all threads before
// any thread reaches DBB 8 (cgra_fabric_done ordering).
// optstep7 (#4): dropped not-last-iter gate (harmless to publish on last iter).
@%p10 mov.b32 %r7, %r15;
// optstep8: advance gpuWall pointer by stride for next iter.
add.s64 %r10, %r10, %r11;
add.s32 %r4, %r4, 1;
setp.lt.s32 %p14, %r4, %c0;
@%p14 bra $DICE_BB0_4;

$DICE_BB0_7:
// Store gpuResult[xidx] = %r15 if isValid AND tx in [%c0, 255-%c0]
// (the threads that "computed" on the LAST iter).
add.s32 %w0, %c0, -1;
setp.gt.s32 %p15, %r2, %w0;
mov.u32 %w1, 255;
sub.s32 %w2, %w1, %c0;
setp.le.s32 %p16, %r2, %w2;
and.pred %p17, %p15, %p16;
and.pred %p18, %p6, %p17;
cvta.to.global.u64 %w3, %c3;
mul.wide.s32 %w4, %r3, 4;
add.s64 %r16, %w3, %w4;
@%p18 st.global.u32 [%r16], %r15;

$DICE_BB0_17:
ret;

}
