// DICECompiler Metadata for: pathfinder (RF-unified v7, real-addr SRF)
// 9 live DBBs (0,1,2,3,4,5,6,7,8,17).
// Publication reg = %r7 (loop-carried "prev").  SRF addr = neighbor*32 + 7.
// Loop body split to avoid intra-DBB %r7 race:
//   DBB 4 : per-iter narrowing predicate
//   DBB 5 : ld.global gpuWall (load-to-use split)
//   DBB 6 : BARRIER + ld.srf OLD %r7 + min/min/add + capture %r15
//   DBB 8 : publish %r7 = %r15 (predicated), counter++, branch -> DBB 4
// cgra_fabric_done ensures all threads finish DBB 6 before any thread
// dispatches DBB 8 -- so DBB 6 always reads pre-iter %r7 globally.
FUNCTION = _Z14dynproc_kerneliPiS_S_iiii;

DBB_ID = 0,
BITSTREAM_ADDR = $DICE_BB0_0,
BITSTREAM_LENGTH = 7,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 1,
LD_DEST_REGS = (%c0, %c1, %c2, %c3, %c4, %c5, %c6),
IS_PARAMETER_LOAD;

DBB_ID = 1,
BITSTREAM_ADDR = $DICE_BB0_1,
BITSTREAM_LENGTH = 15,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 7,
IN_REGS = (%c2, %c4, %c6),
OUT_REGS = (%p0, %p1, %p2, %r0, %r1, %r2, %r3, %r6),
LD_DEST_REGS = (%r7);

DBB_ID = 2,
BITSTREAM_ADDR = $DICE_BB0_2,
BITSTREAM_LENGTH = 12,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 5,
IN_REGS = (%c0, %c4, %r1),
OUT_REGS = (%p3, %p31, %r24, %r25),
BRANCH = 1,
BRANCH_PRED = (%p3),
BRANCH_TARGET = 7,
BRANCH_RECVPC = 7;

DBB_ID = 3,
BITSTREAM_ADDR = $DICE_BB0_3,
BITSTREAM_LENGTH = 18,
UNROLLING_FACTOR = 1,
UNROLLING_STRATEGY = 0,
LAT = 7,
// optstep8 (#4): added 5 ops to precompute gpuWall base ptr (%r10) and stride
// (%r11) so per-iter DBB 5 just needs the load (1 op) and DBB 8 increments
// by stride (1 op).
IN_REGS = (%c1, %c4, %c5, %r2, %r3, %r24, %r25),
OUT_REGS = (%p6, %r4, %r8, %r9, %r10, %r11, %r15);

DBB_ID = 4,
BITSTREAM_ADDR = $DICE_BB0_4,
BITSTREAM_LENGTH = 6,
UNROLLING_FACTOR = 2,
UNROLLING_STRATEGY = 0,
LAT = 3,
IN_REGS = (%p6, %r2, %r4),
OUT_REGS = (%p10);

DBB_ID = 5,
BITSTREAM_ADDR = $DICE_BB0_5,
BITSTREAM_LENGTH = 1,
UNROLLING_FACTOR = 4,
UNROLLING_STRATEGY = 0,
LAT = 2,
// optstep9 (#2): with addr now hoisted to %r10, DBB 5 has 0 PE + 1 LD per
// thread.  Operand-fetch banks at UF=4 {T+10,T+18,T+26,T+2} (mod 32) are
// distinct.  4 LD ports → UF=4 OK.
IN_REGS = (%p10, %r10),
LD_DEST_REGS = (%r20);

DBB_ID = 6,
BITSTREAM_ADDR = $DICE_BB0_6,
BITSTREAM_LENGTH = 6,
UNROLLING_FACTOR = 4,
UNROLLING_STRATEGY = 0,
LAT = 7,
// optstep11 (#2): UF 2 -> 4.  PE=3 (min/min/add), at UF=4 -> 12 PE within
// budget.  Operand-fetch banks at UF=4 from regs {r7,r8,r9,r20} for T,T+8,
// T+16,T+24 = 16 distinct banks (cosets 7,0,1,4 all distinct, all UF strides
// land on different banks).  SRF read cycle 2: 8 reads (4 W + 4 E) to
// distinct banks {T+0,T+6,T+8,T+14,T+16,T+22,T+24,T+30} mod 32 — fits the
// 8 LD ports configured for the CGRA core.
IN_REGS = (%p10, %r7, %r8, %r9, %r20),
OUT_REGS = (%r15),
BARRIER;

DBB_ID = 8,
BITSTREAM_ADDR = $DICE_BB0_8,
BITSTREAM_LENGTH = 5,
UNROLLING_FACTOR = 4,
UNROLLING_STRATEGY = 0,
LAT = 3,
// optstep7+8: dropped not-last-iter gate; added add.s64 to advance %r10.
// optstep10 (#2): UF 2->4.  PE=3 (add.s64, add.s32, setp), at UF=4 -> 12 PE
// within budget.  Reg cosets {r4=4, r10=2, r11=3, r15=7} distinct;
// pairwise distances {6,7,11,1,5,4} none in {8,16,24} → UF=4 OK.
IN_REGS = (%c0, %p10, %r4, %r10, %r11, %r15),
OUT_REGS = (%p14, %r4, %r7, %r10),
BRANCH = 1,
BRANCH_PRED = (%p14),
BRANCH_TARGET = 4,
BRANCH_RECVPC = 7;

DBB_ID = 7,
BITSTREAM_ADDR = $DICE_BB0_7,
BITSTREAM_LENGTH = 11,
UNROLLING_FACTOR = 2,
UNROLLING_STRATEGY = 0,
LAT = 4,
IN_REGS = (%c0, %c3, %p6, %r2, %r3, %r15),
STORE = 1;

DBB_ID = 17,
BITSTREAM_ADDR = $DICE_BB0_17,
RET;
