# DICE simulator config — A100 silicon budget.
#
# Built from gpgpusim_dice_rtx2060s.config with the following A100 overrides:
#   - 108 CGRA clusters (matches A100 SM count) × 4 CPs/cluster = 432 CPs
#   - Per-CP fabric unchanged from DICE-paper: 16 PEs (INT+FPU) + 4 SFUs.
#     Per-cluster total = 64 PE + 16 SFU, matching A100's 64 FP32/INT32 + 16 SFU per SM.
#   - Per-CP RF: 16,384 32-bit regs (64 KB). 4 CPs × 64 KB = 256 KB/SM = A100 RF/SM.
#   - Per-CP SMEM: 49,152 B (48 KB). 4 × 48 KB = 192 KB/SM unified L1+SMEM.
#   - Per-CP L1D: 49,152 B (48 KB). Same 192 KB/SM budget.
#   - L2: 40 mem partitions × 4 sub-partitions × 256 KB = 40 MB (matches A100).
#   - DRAM: HBM2e timing/buswidth/freq from upstream A100 config.
#   - Clocks: 1.41 GHz core / 1.512 GHz DRAM-data (A100).
#   - Compute capability: 8.0.
#   - Kernel launch overhead = 0, max concurrent kernel = 1, no perfect icache
#     (matches the matching gpgpusim_gpu_a100.config tweaks).

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 80

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 0
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 1

# Compute Capability — Ampere SM80
-gpgpu_compute_capability_major 8
-gpgpu_compute_capability_minor 0

# SASS execution (only supported with CUDA >= 4.0)
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# Memory partition count (A100: 40 partitions × 4 sub-part = 160 L2 slices)
-gpgpu_n_mem 40
-gpgpu_n_sub_partition_per_mchannel 4

# Per-CP register file: 65,536/4 = 16,384 regs (64 KB) per CP.
# 4 CPs/cluster × 64 KB = 256 KB/SM = A100 RF/SM.
-gpgpu_shader_registers 16384
-gpgpu_occupancy_sm_number 80

-gpgpu_simd_model 1

# Pipeline widths and FU count per CP (DICE-paper microarch, unchanged):
# 4 SP + 4 INT + 4 SFU + 4 DP + 4 Tensor per CP × 4 CPs = 16/16/16/16/16 per cluster,
# matches A100's per-SM 64 FP32 / 64 INT32 / 16 SFU / 32 FP64 / 4 Tensor when we
# treat each "pipeline-width unit" as a 4-wide lane group. Each per-CP FU still
# issues one warp's worth of work per cycle, II=1.
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_int_units 4
-gpgpu_num_dp_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals (Ampere from upstream A100)
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 2,2,2,2,4
-ptx_opcode_latency_dp 6,6,6,6,330
-ptx_opcode_initiation_dp 4,4,4,4,130
-ptx_opcode_latency_sfu 23
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 25
-ptx_opcode_initiation_tensor 16

# Per-CP unified L1+SMEM — 192 KB/SM ÷ 4 CPs = 48 KB per CP.
# L1D: 48 KB per CP (S:6:128:64 = 6 sets × 64-way × 128 byte = 49,152 B).
# Per-CP L1 port count = 1 → cluster total = 4 × 1 = 4 ports = matches the
# GPU A100 SM's 4 L1 banks (single shared L1 per SM, l1_banks=4). The
# DICE simulator currently has FOUR separate L1s per cluster (one per
# CP); setting per-CP banks=1 makes the aggregate per-cluster L1 port
# bandwidth identical to A100 per-SM. The future shared-L1 branch
# (see doc/shared_l1d_plan.md) will collapse the 4 L1s into 1 and use
# l1_banks=4 directly, at which point the two configs naturally align.
-gpgpu_l1_banks 4
# 48 KB L1 per CP = 3 sets × 128-way × 128 B (matches 2060S DICE's policy
# string format, just scaled in nsets). 4 CPs × 48 KB = 192 KB unified
# L1+SMEM per cluster = A100 per-SM.
-gpgpu_cache:dl1  S:3:128:512,L:L:s:N:L,A:128:8,16:0,32
-gpgpu_l1_latency 34
-gpgpu_smem_latency 28
-gpgpu_gmem_skip_L1D 0
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_flush_l1_cache 1

# SMEM per CP: 48 KB. Default per-block SMEM 48 KB.
-gpgpu_shmem_size 49152
-gpgpu_shmem_sizeDefault 49152
-gpgpu_shmem_per_block 49152
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 80

# L2: 256 KB per L2 slice (S:128:128:16 = 128 × 16 × 128 = 262,144 B). 160 slices = 40 MB.
# set_index_fn = `X` (Ampere bitwise XOR hash), now supported in the DICE
# fork after a 6-line parser patch (the enum, hashing function, and
# dispatch case were already present from upstream gpgpu-sim).
-gpgpu_cache:dl2 S:128:128:16,L:B:m:L:X,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 0

-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
# Realistic icache (not the upstream perfect-icache idealisation).
-gpgpu_perfect_inst_const_cache 0

# Operand collector
-gpgpu_operand_collector_num_units_sp 6
-gpgpu_operand_collector_num_units_sfu 8
-gpgpu_operand_collector_num_in_ports_sp 2
-gpgpu_operand_collector_num_out_ports_sp 2
-gpgpu_num_reg_banks 32
-gpgpu_reg_file_port_throughput 2

-gpgpu_max_insn_issue_per_warp 1

# Interconnection — built-in xbar, Ampere-style subnet/flit sizing.
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_arbiter_algo 1
-icnt_flit_size 40

# Memory partition latency config (A100)
-gpgpu_l2_rop_latency 200
-dram_latency 190

# DRAM scheduler
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# HBM2e DRAM model (from upstream A100 config)
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# HBM2e timing (A100)
-gpgpu_dram_timing_opt nbk=16:CCD=1:RRD=7:RCD=22:RAS=50:RP=22:RC=72:CL=22:WL=4:CDLR=5:WR=19:nbkgrp=4:CCDL=4:RTPL=7
-dram_dual_bus_interface 1

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

# Warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler gto

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs
-power_simulation_enabled 0
-gpuwattch_xml_file gpuwattch_gtx480.xml
-gpgpu_dice_power_model 1
-gpgpu_dice_power_xml /data2/jwang710/DICE-RFSMEM/DICE_ISCA_Eval/dice-test-gpu-rodinia/cuda/dice_test/cfg/accelwattch_dice_sim.xml

# tracing functionality
-trace_enabled 0
-trace_components MEMORY_PARTITION_UNIT,MEMORY_SUBPARTITION_UNIT,INTERCONNECT
-trace_sampling_core 0
-dice_trace_sampling_core 0

-save_embedded_ptx 1
-keep 1

# 108 CGRA clusters (A100 SM count). 4 CPs per cluster (DICE subcore structure):
# per-cluster ALU count = 4 × (16 PE INT+FPU + 4 SFU) = 64 PE + 16 SFU = A100 per-SM.
-gpgpu_n_clusters 108
-gpgpu_n_cores_per_cluster 4

# Per-CP CTA cap and pipeline shape (unchanged from 2060S DICE; 4 × 512 threads = 2048
# threads per cluster, matching A100 per-SM occupancy cap).
-gpgpu_shader_cta 4
-gpgpu_shader_core_pipeline 512:32

# A100 clock domains: 1.41 GHz core / 1.512 GHz DRAM data-rate (HBM2e)
-gpgpu_clock_domains 1410.0:1410.0:1410.0:1512.0

# DICE microarchitecture knobs — UNCHANGED from the 2060S DICE config; the
# fabric size, RF banking, and ldst-port count are part of the DICE-paper
# microarch claim and should not be perturbed by the A100 silicon-budget
# config.
-dice 1
-dice_cgra_core_max_threads 512
-dice_cgra_core_max_rf_banks 33
-dice_cgra_core_num_ld_ports 4
-dice_cgra_core_num_st_ports 4
-dice_cgra_core_num_ld_ports_queue_size 32
-dice_cgra_core_num_st_ports_queue_size 32
-dice_cgra_core_rf_cgra_wb_buffer_size 32
-dice_cgra_core_rf_ldst_wb_buffer_size 32

-dice_ldst_unit_enable_port_coalescing 0
-dice_ldst_unit_enable_temporal_coalescing 1
-dice_ldst_unit_temporal_coalescing_interval 8
-dice_ldst_unit_temporal_coalescing_max_cmd 8
-dice_enable_unrolling 1
-dice_perfect_bitstream_cache 0
-dice_enable_bitstream_prefetcher 0
-dice_enable_metadata_prefetcher 0

# Phase B/C/D/E shared caches + bank arbiter (matches A100 per-SM L1 + iCache)
-dice_shared_l1d 1
-dice_shared_il1 1
-dice_shared_l1b 1
